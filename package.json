{
  "name": "@internetarchive/promised-singleton",
  "version": "0.2.1",
  "description": "A class for lazy-loading singletons.",
  "author": "promised-singleton",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc:watch": "tsc --watch",
    "docs": "typedoc",
    "prepare": "tsc",
    "lint:eslint": "eslint --ext .ts,.html . --ignore-path .gitignore",
    "format:eslint": "eslint --ext .ts,.html . --fix --ignore-path .gitignore",
    "lint:prettier": "prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format:prettier": "prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "npm run format:eslint && npm run format:prettier",
    "test": "npm run lint && tsc && karma start --coverage",
    "test:watch": "concurrently --kill-others --names tsc,karma \"npm run tsc:watch\" \"karma start --auto-watch=true --single-run=false\""
  },
  "devDependencies": {
    "@open-wc/eslint-config": "^2.1.0",
    "@open-wc/testing": "^2.5.33",
    "@open-wc/testing-karma": "^3.4.8",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "concurrently": "^5.3.0",
    "deepmerge": "^3.3.0",
    "es-dev-server": "^1.60.2",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.15.0",
    "husky": "^1.3.1",
    "lint-staged": "^8.2.1",
    "lit-html": "^1.4.1",
    "prettier": "^2.8.8",
    "tslib": "^1.14.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "extends": [
      "@open-wc/eslint-config",
      "eslint-config-prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "publishConfig": {
    "access": "public"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
